<?xml version="1.0" encoding="utf-8"?>
<!--
  The iOS app sets NSAllowsArbitraryLoads + NSAllowsArbitraryLoadsForMedia, which disables ATS
  app-wide (station stream URLs and metadata APIs are frequently plain HTTP). This mirrors that by
  permitting cleartext traffic for all domains rather than just the handful iOS separately listed
  in NSExceptionDomains, since those were redundant once arbitrary loads were already allowed.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
